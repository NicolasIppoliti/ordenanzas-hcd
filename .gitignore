# Pipeline scratch: fetched PDFs, per-run only, never committed
archive/

# Astro build output
dist/

# Python virtualenv (uv-managed)
.venv/

# Node dependencies
node_modules/

# Astro generated types
.astro/

# Secrets never live in this repository. It is PUBLIC, and every weekly sync
# commits to it, so a stray .env would be published within days. RESEND_API_KEY,
# CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID belong in GitHub Actions secrets;
# the pipeline reads them from the environment and never writes them anywhere.
.env
.env.*
!.env.example
.dev.vars
.wrangler/

# Tool caches — regenerated on every run, never reviewed
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Lockfiles ARE committed on purpose: reproducible installs in CI.
# They are generated, so exclude them from review-size accounting rather
# than from version control.
# Local Pi runtime state
.atl/

# Playwright MCP scratch: browser snapshots and console logs from verification runs
.playwright-mcp/

# Ad-hoc screenshots from design/verification work
doc-*.png
