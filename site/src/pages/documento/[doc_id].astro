---
// Ordinance-detail spec + design.md D4/D5/D7/D8/D12: one route for every
// record, type-neutral. getStaticPaths runs over the whole manifest — the
// route is derived, never a hardcoded count (D7).
import DocumentText from '../../components/DocumentText.astro';
import Layout from '../../components/Layout.astro';
import type { ManifestDocument, Status } from '../../lib/contract';
import { getDocuments, loadDocumentBody } from '../../lib/data';
import { buildRelatedIndex, type RelatedTarget } from '../../lib/related';
import { DOC_TYPE_LABELS, formatDocHeading, formatDocIdentifier } from '../../lib/labels';
import { getAnioFilterValue, getTextoFilterValue, getTipoFilterValue } from '../../lib/search';

export async function getStaticPaths() {
  const documents = getDocuments();
  // Built once for the whole corpus, then handed to each page as a prop —
  // recomputing the union per page would be O(n^2) over 1,038 records.
  const relatedIndex = buildRelatedIndex(documents);
  const byId = new Map(documents.map((doc) => [doc.doc_id, doc] as const));

  return documents.map((doc) => {
    const siblings = doc.number_variants
      .filter((id) => id !== doc.doc_id)
      .map((id) => byId.get(id))
      .filter((sibling): sibling is ManifestDocument => sibling !== undefined);
    return {
      params: { doc_id: doc.doc_id },
      props: { doc, related: relatedIndex.get(doc.doc_id) ?? [], siblings },
    };
  });
}

interface Props {
  doc: ManifestDocument;
  related?: RelatedTarget[];
  siblings?: ManifestDocument[];
}

const { doc, related = [], siblings = [] } = Astro.props as Props;
const heading = formatDocHeading(doc);
const identifier = formatDocIdentifier(doc);
const body = loadDocumentBody(doc);
const rawText = body?.text ?? null;
// PDF extraction preserves the source's leading and trailing whitespace — this
// corpus carries a median of 31 blank characters before the first word (mean 44),
// which `pre-wrap`
// renders faithfully as a hole between the heading and the text. Trimming the
// ENDS is presentation, not editing: no word, line break or internal spacing of
// the document is touched, so the transcript stays exactly what the HCD published.
// A body of nothing but whitespace is textless in every sense that matters to a
// reader, and treating it as text ships the same blank section the reason table
// exists to prevent. No document in the corpus is in this state today.
const trimmed = rawText === null ? null : rawText.trim();
const text = trimmed === '' ? null : trimmed;
// A reader thinks in pages, not characters. 676.897 caracteres — the trimmed
// length of the largest document, whose raw length is 676,955 — is a true
// number that tells a neighbour nothing; "207 páginas" tells them whether to
// open it on a phone.
const pageCount = body?.pages ?? null;
const sizeLabel =
  pageCount !== null
    ? `${pageCount.toLocaleString('es-AR')} páginas`
    : `${(text?.length ?? 0).toLocaleString('es-AR')} caracteres`;

// Task 4a.12a: 9 documents carry more than 50,000 characters of extracted text.
// The threshold counts characters of the trimmed body, not bytes. The largest
// document is 207 pages: 676,955 raw characters, 676,897 trimmed, 692 KB of
// UTF-8. The full body MUST stay in the DOM so
// Pagefind indexes it in 4b — truncation is not acceptable. A closed
// <details> is progressive disclosure that keeps every byte in the markup.
const LARGE_TEXT_THRESHOLD = 50_000;

/* Every status the contract allows, so a new one cannot silently render a blank
   section — `Record<Status, string>` makes that a type error instead. */
const NO_TEXT_REASON: Record<Status, string> = {
  // `ok` reaches this branch only when the record carries no `text_path`, or
  // when the extracted body is empty — never as a read failure, which throws.
  ok: 'Sin texto extraído para este documento.',
  no_text: 'Sin texto indexado.',
  pending: 'Todavía sin procesar. Se indexará en la próxima sincronización.',
  error: 'La última sincronización falló para este documento.',
};
const isLargeText = text !== null && text.length > LARGE_TEXT_THRESHOLD;
---

<Layout title={heading} description={doc.title ?? identifier}>
  <article data-pagefind-body>
    <span data-pagefind-filter={`tipo:${getTipoFilterValue(doc.doc_type)}`} hidden></span>
    <span data-pagefind-filter={`anio:${getAnioFilterValue(doc.year)}`} hidden></span>
    <span data-pagefind-filter={`texto:${getTextoFilterValue(doc.status)}`} hidden></span>
    <h1>{heading}</h1>
    {!doc.title && <p class="muted">Sin título descriptivo en el archivo de origen.</p>}
    {
      doc.doc_type === 'sin clasificar' && (
        <p class="muted">El origen no indica el tipo de este documento.</p>
      )
    }

    <dl class="metadata">
      <div>
        <dt>Tipo de documento</dt>
        <dd>{DOC_TYPE_LABELS[doc.doc_type]}</dd>
      </div>
      {
        doc.number !== null && (
          <div>
            <dt>Número</dt>
            <dd>{doc.number}</dd>
          </div>
        )
      }
      {
        doc.expediente !== null && (
          <div>
            <dt>Expediente</dt>
            <dd>{doc.expediente}</dd>
          </div>
        )
      }
      <div>
        <dt>Año</dt>
        <dd>{doc.year !== null ? doc.year : 'Año no determinado'}</dd>
      </div>
    </dl>

    <p>
      <a href={doc.source_url}>Ver el PDF oficial en hcdrosales.gob.ar</a>
    </p>

    {
      siblings.length > 0 && (
        <section aria-label="Archivos con el mismo número" data-pagefind-ignore>
          <h2>Archivos con el mismo número</h2>
          <p>El HCD publicó más de un archivo con este número.</p>
          <ul>
            {siblings.map((sibling) => (
              <li>
                <a href={`/documento/${sibling.doc_id}`}>{formatDocHeading(sibling)}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-label="Texto del documento">
      <h2>Texto</h2>
      {
        /* Fail visibly: every status that carries no text says why. `pending` and
           `error` are in the contract and reachable from a partial sync, and a
           section with a heading and nothing under it is the silent incomplete
           page the rules forbid. */
        text === null && <p class="muted">{NO_TEXT_REASON[doc.status]}</p>
      }
      {text !== null && !isLargeText && <DocumentText text={text} />}
      {
        text !== null && isLargeText && (
          <details>
            <summary>Ver texto completo ({sizeLabel})</summary>
            <DocumentText text={text} />
          </details>
        )
      }
    </section>

    {
      related.length > 0 && (
        <section aria-label="Documentos relacionados" data-pagefind-ignore>
          {/* Not "Ordenanzas": the related index does not filter by type, and the
              archive holds convenios, decretos, resoluciones and anexos too. */}
          <h2>Documentos relacionados</h2>
          <ul>
            {related.map((target) => (
              <li>
                <a href={`/documento/${target.doc_id}`}>{formatDocHeading(target)}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Layout>

<style>
  /* Metadata reads as a reference table, not as prose: label and value on one
     line, labels quiet, values carrying the weight. */
  .metadata {
    margin: var(--space-6) 0;
    padding: var(--space-4);
    background: var(--bg-surface);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }
  .metadata div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-1);
  }
  .metadata dt {
    font-weight: var(--weight-medium);
    color: var(--text-muted);
    min-width: 9ch;
  }
  .metadata dd {
    margin: 0;
  }

  /* Sibling and related-document lists. Proximity does the grouping: the gap
     inside a list is smaller than the gap that separates it from the text. */
  section[aria-label] {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }
  section[aria-label] h2 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-3);
  }
  section[aria-label] ul {
    margin: 0;
    padding-left: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* The nine documents over 50 KB of extracted text. The full body stays in the DOM so
     Pagefind indexes it — collapsing is about not dropping a reader into 207
     pages unannounced, not about shipping fewer bytes. */
  details {
    margin-top: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }
  details > summary {
    cursor: pointer;
    font-weight: var(--weight-medium);
    /* A summary is a control, so it gets the same 48px floor as every other
       control on the site. */
    min-height: 3rem;
    display: flex;
    align-items: center;
  }
  details[open] > summary {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  a[href$='.pdf'] {
    font-weight: var(--weight-medium);
  }
</style>
