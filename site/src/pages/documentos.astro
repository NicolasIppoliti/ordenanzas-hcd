---
// DESIGN.md risk 3: browse the whole corpus, not just search it.
//
// The peers in this category build faceted search because their corpora are
// millions of records. This one is 1,038 — the whole archive fits on one page,
// grouped by year. A resident often does not know the number; they know roughly
// when. Search demands you know what to type; browsing does not.
//
// One page, not one page per year: a reader who guesses the wrong year finds
// the right one by scrolling instead of by navigating, and Ctrl+F works over
// the whole archive with no JavaScript at all.
//
// Measured cost of that choice: 185,386 bytes of HTML — 33,029 gzipped, 24,795
// brotli, both from zlib at its default level, which is what actually goes over
// the wire. (The `gzip` CLI reports 33,099 for the same bytes because it stores
// the filename in the header; the wire figure is the one that matters.) It is by
// far the heaviest page in the archive after the 207-page fiscal ordinance, and
// it is the price of the whole corpus in one place. No JavaScript, no request
// after the first.
import Layout from '../components/Layout.astro';
import { getDocuments } from '../lib/data';
import { groupByYear } from '../lib/browse';
import { documentHref, formatDocHeading } from '../lib/labels';
import { getAnioFilterValue } from '../lib/search';

const documents = getDocuments();
const total = documents.length.toLocaleString('es-AR');

const { years, undated } = groupByYear(documents);
const undatedLabel = getAnioFilterValue(null);
---

<Layout
  title="Todos los documentos por año — Archivo del HCD"
  description={`Los ${total} documentos del Honorable Concejo Deliberante de Coronel Rosales, agrupados por año.`}
>
  <h1>Todos los documentos</h1>
  <p>
    Los {total} documentos del archivo, agrupados por el año que consta en el documento. Si
    no sabés el número, esta es la forma de encontrarlo.
  </p>

  {/* The whole page is an index of links to documents that are themselves indexed.
      Leaving it in Pagefind would put 1,038 titles into every query's haystack a
      second time, which is the same reason the nav, the footer and the related
      lists are ignored. */}
  <div class="browse" data-pagefind-ignore>
    <nav aria-label="Índice de años" class="year-index">
      {years.map(({ year }) => <a href={`#anio-${year}`}>{year}</a>)}
      {undated.length > 0 && <a href="#anio-sin-determinar">{undatedLabel}</a>}
    </nav>

    {
      years.map(({ year, documents: group }) => (
        <section aria-labelledby={`anio-${year}`}>
          <h2 id={`anio-${year}`}>
            {year} <span class="count">{group.length} documentos</span>
          </h2>
          <ul>
            {group.map((doc) => (
              <li>
                <a href={documentHref(doc.doc_id)}>{formatDocHeading(doc)}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {undated.length > 0 && (
    <section aria-labelledby="anio-sin-determinar">
      <h2 id="anio-sin-determinar">
        {undatedLabel} <span class="count">{undated.length} documentos</span>
      </h2>
      <p class="muted">
        El HCD no consignó un año en estos documentos. El archivo no lo deduce: mostrar un
        año inferido sería afirmar algo que la fuente no dice.
      </p>
      <ul>
        {undated.map((doc) => (
          <li>
            <a href={documentHref(doc.doc_id)}>{formatDocHeading(doc)}</a>
          </li>
        ))}
      </ul>
    </section>
    )}
  </div>
</Layout>

<style>
  /* The year index is the only navigation on the page, so it stays reachable
     while scrolling 1,038 rows on a phone. */
  .year-index {
    position: sticky;
    top: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    margin-bottom: var(--space-6);
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .year-index a {
    font-variant-numeric: tabular-nums;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  .browse section {
    margin-top: var(--space-8);
  }
  .browse h2 {
    /* The index is sticky, so an anchor jump would otherwise land the heading
       underneath it. Clears the bar's own height plus a line of breathing room. */
    scroll-margin-top: var(--space-16);
    font-size: var(--text-xl);
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  /* The count is a fact about the group, not part of its name — it reads as
     metadata beside the year rather than competing with it.
     
     `font-family` is set explicitly because this span lives INSIDE the h2 and
     would otherwise inherit Fraunces, which ships at one weight (600). Asking it
     for 400 does not fail; the browser synthesises a fake 400 by thinning the
     outlines, and no test can see it. Instrument Sans carries 400–700 for real,
     and metadata belongs to the sans face anyway. */
  .count {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
    color: var(--text-muted);
  }

  .browse ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .browse li {
    padding-block: var(--space-2);
  }
  .browse li + li {
    border-top: 1px solid var(--border);
  }
  /* `.muted` itself is global, in Layout's stylesheet. Only the measure is
     local, because it is this page's paragraph that needs it. */
  .muted {
    max-width: var(--measure);
  }
</style>
