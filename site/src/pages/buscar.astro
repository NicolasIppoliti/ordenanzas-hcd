---
// Ordinance-search spec + design.md "Build cost at 1,038 pages" and
// "Accessibility and Mobile Payload": a real <form> with a labelled
// <input type="search">, an aria-live="polite" results region, and the
// anio/tipo/texto filters. This page itself carries no data-pagefind-body
// — it is the search UI, not a document to index. The Pagefind runtime
// (~30 KB) is imported dynamically, only from client-search.ts, only on
// interaction — 0 KB of it ships in this page's own bundle.
import Layout from '../components/Layout.astro';
import { getDocuments } from '../lib/data';
import { DOC_TYPE_LABELS } from '../lib/labels';
import { TYPE_FILTER_LABELS, TYPE_FILTER_OPTIONS, buildYearOptions } from '../lib/search';

const documents = getDocuments();
const total = documents.length.toLocaleString('es-AR');
const yearOptions = buildYearOptions(documents);
---

<Layout
  title={`Buscar — Archivo de Ordenanzas del HCD`}
  description={`Buscar en ${total} documentos publicados por el Honorable Concejo Deliberante de Coronel Rosales.`}
  searchBand={false}
>
  <h1>Buscar en {total} documentos</h1>

  <form id="search-form">
    <div class="field">
      <label for="q">Buscar</label>
      <input type="search" id="q" name="q" placeholder="Número, expediente, título o texto…" />
    </div>
    <div class="filters">
      <label class="field" for="tipo">
        Tipo de documento
        <select id="tipo" name="tipo">
          <option value="">Todos los tipos</option>
          {
            TYPE_FILTER_OPTIONS.map((type) => (
              <option value={DOC_TYPE_LABELS[type]}>{TYPE_FILTER_LABELS[type]}</option>
            ))
          }
        </select>
      </label>
      <label class="field" for="anio">
        Año
        <select id="anio" name="anio">
          <option value="">Todos los años</option>
          {yearOptions.map((year) => <option value={year}>{year}</option>)}
        </select>
      </label>
      <label class="field" for="texto">
        Texto indexado
        <select id="texto" name="texto">
          <option value="">Todos</option>
          <option value="Con texto indexado">Con texto indexado</option>
          <option value="Sin texto indexado">Sin texto indexado</option>
        </select>
      </label>
    </div>
    <button type="submit">Buscar</button>
  </form>

  {/* Fail visibly. Pagefind is a JavaScript index and there is no server to
      query, so with scripting off this page cannot search at all. Saying
      nothing would leave a reader who arrived from the header band staring at
      an empty field and a message that describes a state they are not in. The
      browse page needs no JavaScript, so it is the honest alternative. */}
  <noscript>
    <p class="notice-noscript">
      La búsqueda necesita JavaScript: el índice se resuelve en tu navegador, sin servidor
      que consultar. Podés <a href="/documentos">ver los {total} documentos por año</a>,
      que funciona sin JavaScript.
    </p>
  </noscript>

  <div id="results" role="region" aria-live="polite" aria-label="Resultados de la búsqueda">
    <p>Escribí un término para buscar en {total} documentos, o elegí un filtro.</p>
  </div>

  <script>
    import {
      EMPTY_QUERY_MESSAGE,
      NO_RESULTS_MESSAGE,
      toDisplayResult,
      type RawSearchResultData,
    } from '../lib/search';

    const form = document.querySelector<HTMLFormElement>('#search-form')!;
    const input = document.querySelector<HTMLInputElement>('#q')!;
    const tipoSelect = document.querySelector<HTMLSelectElement>('#tipo')!;
    const anioSelect = document.querySelector<HTMLSelectElement>('#anio')!;
    const textoSelect = document.querySelector<HTMLSelectElement>('#texto')!;
    const results = document.querySelector<HTMLDivElement>('#results')!;

    // Pagefind's generated JS is a build artifact of `pagefind --site dist`
    // (task 4b.8) — it does not exist in the source tree, so this import
    // must stay a runtime string Vite never tries to resolve at build time.
    type PagefindModule = {
      init(): Promise<void>;
      search(
        query: string | null,
        options?: { filters?: Record<string, string[]> }
      ): Promise<{ results: Array<{ data(): Promise<RawSearchResultData> }> }>;
    };

    let pagefind: PagefindModule | null = null;
    async function ensurePagefind(): Promise<PagefindModule> {
      if (!pagefind) {
        // Generated by `pagefind --site dist` (task 4b.8) — it exists only
        // in the build output, never in the source tree, so this path
        // cannot be a statically resolvable module for `tsc`/Vite.
        const modulePath = '/pagefind/pagefind.js';
        pagefind = (await import(/* @vite-ignore */ modulePath)) as PagefindModule;
        await pagefind.init();
      }
      return pagefind;
    }

    function currentFilters(): Record<string, string[]> {
      const filters: Record<string, string[]> = {};
      if (tipoSelect.value) filters.tipo = [tipoSelect.value];
      if (anioSelect.value) filters.anio = [anioSelect.value];
      if (textoSelect.value) filters.texto = [textoSelect.value];
      return filters;
    }

    function renderMessage(message: string) {
      results.innerHTML = '';
      const message_el = document.createElement('p');
      message_el.textContent = message;
      results.append(message_el);
    }

    async function runSearch() {
      const query = input.value.trim();
      const filters = currentFilters();
      if (query.length === 0 && Object.keys(filters).length === 0) {
        renderMessage(EMPTY_QUERY_MESSAGE);
        return;
      }
      const pf = await ensurePagefind();
      const search = await pf.search(query.length > 0 ? query : null, { filters });
      if (search.results.length === 0) {
        renderMessage(NO_RESULTS_MESSAGE);
        return;
      }
      const items = await Promise.all(
        search.results.map(async (result) => toDisplayResult(await result.data()))
      );
      results.innerHTML = '';
      for (const item of items) {
        const article = document.createElement('article');
        article.className = 'search-result';

        const link = document.createElement('a');
        link.href = item.url;
        link.textContent = item.title;
        article.append(link);

        const meta = document.createElement('p');
        meta.className = 'search-result-meta';
        meta.textContent = item.anio ? `${item.tipo} · ${item.anio}` : item.tipo;
        article.append(meta);

        const body = document.createElement('p');
        if (item.hasIndexedText && item.excerpt) {
          body.className = 'excerpt';
          // Pagefind's own excerpt HTML (<mark> around matches) over our
          // own indexed pages — never user-submitted content.
          body.innerHTML = item.excerpt;
        } else {
          body.className = 'muted';
          body.textContent = 'Sin texto indexado.';
        }
        article.append(body);

        results.append(article);
      }
    }

    let debounceTimer: ReturnType<typeof setTimeout> | undefined;
    function scheduleSearch() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => void runSearch(), 150);
    }

    input.addEventListener('input', scheduleSearch);
    tipoSelect.addEventListener('change', scheduleSearch);
    anioSelect.addEventListener('change', scheduleSearch);
    textoSelect.addEventListener('change', scheduleSearch);
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      void runSearch();
    });

    // The header band on every other page is a plain GET form pointing here, so
    // a reader arrives with their query already in the URL. Ignoring it would
    // make the band decoration: they would land on an empty field having
    // already typed. The filters are read too, so a result page can be shared
    // or bookmarked as the exact search that produced it.
    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q');
    if (initialQuery !== null) input.value = initialQuery;
    for (const [name, select] of [
      ['tipo', tipoSelect],
      ['anio', anioSelect],
      ['texto', textoSelect],
    ] as const) {
      const value = params.get(name);
      // Only a value the select actually offers: the query string is
      // user-controlled, and an unknown filter would silently return nothing.
      if (value !== null && [...select.options].some((option) => option.value === value)) {
        select.value = value;
      }
    }
    if (input.value.trim().length > 0 || Object.keys(currentFilters()).length > 0) {
      void runSearch();
    }
  </script>
</Layout>

<style>
  /* This is the only page where a visitor does something rather than reads, and
     it is the one most likely to be used one-handed on a phone. Every control
     clears the 48px web-mobile touch minimum. */
  form {
    margin-block: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--measure);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  /* Label above the field, never a placeholder standing in for one — the
     placeholder disappears the moment someone starts typing, taking the only
     description of the field with it. */
  label {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .notice-noscript {
    background: var(--notice-bg);
    border-left: 3px solid var(--notice-border);
    color: var(--notice-text);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    max-width: var(--measure);
  }
  input[type='search'],
  select {
    font: inherit;
    font-size: var(--text-base);
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    min-height: 3rem;
    width: 100%;
  }
  input[type='search']::placeholder {
    color: var(--text-muted);
  }
  input[type='search']:focus-visible,
  select:focus-visible {
    border-color: var(--focus);
  }
  .filters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-4);
    margin: 0;
  }
  button[type='submit'] {
    font: inherit;
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--bg);
    background: var(--link);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-6);
    min-height: 3rem;
    cursor: pointer;
    align-self: start;
    transition: background var(--duration-micro) var(--ease-out);
  }
  button[type='submit']:hover {
    background: var(--link-hover);
  }
  button[type='submit']:active {
    background: var(--link-hover);
    transform: translateY(1px);
  }
  button[type='submit']:disabled {
    background: var(--n-500);
    cursor: not-allowed;
  }

  /* Results are injected at runtime by the Pagefind client, so they never carry
     Astro's scope attribute — these rules have to be global or they silently do
     nothing. */
  :global(.search-result) {
    border-bottom: 1px solid var(--border);
    padding-block: var(--space-4);
  }
  :global(.search-result a) {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
  }
  :global(.search-result-meta),
  :global(.search-result .excerpt) {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin: var(--space-1) 0;
  }
  :global(.search-result .excerpt) {
    color: var(--text);
    line-height: var(--leading-normal);
  }
  /* Pagefind marks matches with <mark>, whose browser default is a saturated
     yellow — the one colour here that would read as an editorial highlight on a
     legal document. The match is carried by weight and an underline instead,
     which also survives dark mode and does not depend on colour alone. */
  :global(.search-result mark) {
    background: transparent;
    color: inherit;
    font-weight: var(--weight-bold);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
