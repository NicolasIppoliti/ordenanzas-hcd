---
// The home is a landing and an index at once: it has to make a reader want to
// stay and give them somewhere to go in the same screen. It answers three
// questions, in this order — what can I do here, how big is this, and what is
// in it — and every answer is a measured fact rather than a claim.
//
// Search is the hero, because on this page it is the whole point; the header
// band hides itself here rather than shipping a second `q` field. The shortcut
// chips are the invitation to touch something before you know what to type, and
// they are searches, never categories: a count of documents that mention a word
// is a fact, a category would be a classification nobody made.
//
// D12: copy counts documentos, never ordenanzas. "Recent" means the highest
// number within the most recent stated year — the closest reading of recency
// the manifest supports, since no record carries a sanction date.
//
// The tiebreak inside a year is load-bearing, not decoration: 2026 holds nine
// records and this list shows eight. Ordering by doc_id instead dropped 4457,
// the highest number in the archive, from a section headed "lo más nuevo".
//
// The copy speaks to a resident and takes every number from the corpus. It says
// nothing about the body that publishes these documents. That restraint is a
// written rule of this project and also plain sense: the archive is unofficial
// and exists because the HCD tolerates it, so any sentence whose energy came
// from an enemy would be aimed at the only enemy available.
import Layout from '../components/Layout.astro';
import ArchiveFacts from '../components/ArchiveFacts.astro';
import DocCard from '../components/DocCard.astro';
import SearchHero from '../components/SearchHero.astro';
import YearStrip from '../components/YearStrip.astro';
import { getDocuments, loadDocumentBody } from '../lib/data';
import { homeHighlights } from '../lib/highlights';

const documents = getDocuments();
const total = documents.length.toLocaleString('es-AR');
const { stats, shortcuts } = homeHighlights(documents);

// The page count of the longest document, which is what a reader understands —
// 207 páginas says something; 676.955 caracteres says nothing.
const longest = documents.find((doc) => doc.doc_id === stats.longest.doc_id);
const longestPages = longest ? (loadDocumentBody(longest)?.pages ?? null) : null;

const recent = [...documents]
  .sort((a, b) => {
    if (a.year !== b.year) {
      // A record with no year cannot be placed on the timeline, so it goes last
      // rather than being guessed into one (D10).
      if (a.year === null) return 1;
      if (b.year === null) return -1;
      return b.year - a.year;
    }
    if (a.number !== b.number) {
      if (a.number === null) return 1;
      if (b.number === null) return -1;
      return b.number - a.number;
    }
    return a.doc_id.localeCompare(b.doc_id, 'es');
  })
  .slice(0, 8);
---

<Layout
  title={`Los ${total} documentos del Concejo Deliberante de Coronel Rosales, buscables`}
  description={`Los ${total} documentos publicados por el Honorable Concejo Deliberante de Coronel Rosales, completos y consultables.`}
  searchBand={false}
>
  <SearchHero total={total} shortcuts={shortcuts} />

  <section class="stats" aria-label="El archivo en números">
    <div>
      <b>{total}</b>
      <span>documentos</span>
    </div>
    <div>
      <b>{stats.withText.toLocaleString('es-AR')}</b>
      <span>con el texto completo adentro</span>
    </div>
    <div>
      <b>{stats.firstYear}—{stats.lastYear}</b>
      <span>de punta a punta</span>
    </div>
    <div>
      <b>Semanal</b>
      <span>se sincroniza con el HCD</span>
    </div>
  </section>

  <section aria-labelledby="que-hay">
    <h2 id="que-hay">Si no sabés el número, empezá por el año</h2>
    <YearStrip documents={documents} />
  </section>

  <section aria-labelledby="datos">
    <h2 id="datos">Tres cosas que tiene este archivo</h2>
    <p class="note">
      Conteos y extremos medidos sobre el corpus. Ninguno interpreta qué dice una ordenanza, y
      cada uno lleva a los documentos que lo respaldan.
    </p>
    <ArchiveFacts stats={stats} longestPages={longestPages} />
  </section>

  <section aria-labelledby="ultimos">
    {/* Not "lo último que sancionó el Concejo". This list carries no type
        filter, and the archive holds 28 convenios, 8 anexos, one resolución and
        one decreto: a convenio is signed and a decreto issued, so that heading
        would assert a legislative act that did not happen the first time a
        non-ordenanza reaches the top. It also has no sanction date to work
        from, so the heading says which ordering it is showing instead of
        claiming a recency it cannot establish. */}
    <h2 id="ultimos">Lo más nuevo del archivo, por año y número</h2>
    <ul class="doc-list">
      {recent.map((doc) => <DocCard doc={doc} />)}
    </ul>
  </section>
</Layout>

<style>
  /* The one filled surface on the page. It earns that by being the only thing
     here a reader takes in without reading — and it stays inside the measure
     like everything else, so it is a band, not a bleed. */
  .stats {
    margin-top: var(--space-12);
    /* Inline padding as well as block: without it the first figure starts flush
       against the surface's own edge and reads as clipped. */
    padding: var(--space-6);
    border-block: 1px solid var(--border);
    background: var(--bg-surface);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }
  /* Serif, and NO `tabular-nums`: Fraunces carries no `tnum` feature even
     upstream, so the declaration was a no-op that read as a measured decision.
     These are display figures — one number per cell, nothing to align with —
     which is the exception DESIGN.md states for the data-in-sans rule. */
  .stats b {
    display: block;
    font-family: var(--font-serif);
    font-weight: var(--weight-semibold);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }
  .stats span {
    display: block;
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-top: var(--space-2);
    max-width: 18ch;
  }

  section:not(.stats) {
    margin-top: var(--space-12);
  }
  section h2 {
    font-size: var(--text-xl);
    margin: 0;
  }
  .note {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    max-width: var(--measure);
  }

  /* This rule must live here, with the element. Astro scopes styles per
     component: a `.doc-list` class used in this file and defined anywhere else
     ships a selector that matches nothing — which is exactly how these
     documents ended up rendering with the browser's default bullets. */
  .doc-list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  @media (max-width: 46rem) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
      row-gap: var(--space-6);
    }
  }
</style>
