---
// DESIGN.md implementation gap item 5: search lives in the header, on every
// page, the way legislation.gov.uk carries it.
//
// Ranked goal 1 is "por fin puedo encontrar algo". Most visits land on a single
// ordinance from a search engine, and that reader — the one who most needs to
// search again — is exactly the one who had nowhere to do it.
//
// It is a plain GET form, not a widget. That is the design, not a shortcut: it
// adds ZERO bytes of script to the 1,038 document pages. A live-suggestion box
// here would have shipped the ~30 KB Pagefind runtime on every page of a public
// archive read on municipal-town phones, to save a single navigation.
//
// It does NOT make search work without JavaScript. The form navigates, but
// Pagefind is a JavaScript index and there is no server to query — so /buscar
// says so in a <noscript>, and points at /documentos, which is the browsable
// route that genuinely needs nothing.
interface Props {
  /** The search page renders its own, fuller form; two would collide on `id`. */
  hidden?: boolean;
}

const { hidden = false } = Astro.props;
---

{/* `data-pagefind-ignore` rather than relying on every page declaring a
    `data-pagefind-body`: this is chrome that repeats on 1,042 pages, and the day
    a page forgets that attribute the word "Buscar" would enter the haystack a
    thousand times over. Measured either way: 21,334 words. */}
{
  !hidden && (
    <form class="search-band" action="/buscar" method="get" role="search" data-pagefind-ignore>
      <label for="q-band">Buscar</label>
      <input
        type="search"
        id="q-band"
        name="q"
        placeholder="Número, expediente, título o texto…"
        enterkeyhint="search"
      />
      <button type="submit">Buscar</button>
    </form>
  )
}

<style>
  .search-band {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    margin-top: var(--space-3);
  }
  /* The label is visible on wide screens and hidden — but never removed — on a
     phone, where the placeholder and the button carry the meaning and the row
     has no width to spare. Removing it would leave the field unnamed for a
     screen reader. */
  .search-band label {
    font-size: var(--text-sm);
    color: var(--text-muted);
    white-space: nowrap;
  }
  .search-band input {
    font: inherit;
    font-size: var(--text-base);
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    /* 48px: the same floor the search page's own controls use. One control,
       one minimum. */
    min-height: 3rem;
    flex: 1;
    min-width: 0;
  }
  .search-band button {
    font: inherit;
    font-size: var(--text-sm);
    color: var(--bg);
    background: var(--link);
    border: 1px solid var(--link);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-4);
    min-height: 3rem;
    cursor: pointer;
  }
  .search-band button:hover {
    background: var(--link-hover);
    border-color: var(--link-hover);
  }

  @media (max-width: 34rem) {
    .search-band label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
