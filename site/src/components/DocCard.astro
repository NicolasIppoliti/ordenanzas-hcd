---
// D4/D8: renders a record's type + number/title exactly as the detail heading
// does, plus the explicit note for a null title. Never colour-only — the type
// label is always text (D8's "never colour-only" requirement, checked in the
// search result surface too).
//
// The number hangs in its own tabular column, the way the article renderer sets
// article numbers. It is the identifier a reader arrives with, and a column is
// what lets someone scan 4449 against 4454 without reading either line.
// Measured against the manifest: 51 of the 1,038 records carry no number at
// all, so the column is simply empty for them — an invented placeholder would
// be the same class of error as an invented title.
//
// No body excerpt: the extracted text opens with the same municipal letterhead
// on every document, so the excerpt here was thirty identical uppercase words
// carrying nothing a reader could act on.
import type { ManifestDocument } from '../lib/contract';
import { DOC_TYPE_LABELS, formatDocIdentifier } from '../lib/labels';

interface Props {
  doc: ManifestDocument;
}

const { doc } = Astro.props;
// The title when the source gave one; otherwise the identifier, never a
// stand-in phrase pretending to be a name.
const label = doc.title ?? formatDocIdentifier(doc);
const typeLabel = DOC_TYPE_LABELS[doc.doc_type];
const meta = doc.year !== null ? `${typeLabel} · ${doc.year}` : typeLabel;
---

<li class="doc-card">
  <span class="doc-num">{doc.number}</span>
  <a class="doc-title" href={`/documento/${doc.doc_id}`}>{label}</a>
  <p class="doc-meta">
    {meta}
    {!doc.title && <span> · sin título en el archivo de origen</span>}
  </p>
</li>

<style>
  .doc-card {
    display: grid;
    grid-template-columns: 6ch 1fr;
    gap: 0 var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--border);
    align-items: baseline;
  }
  .doc-card:last-child {
    border-bottom: 1px solid var(--border);
  }
  .doc-num {
    font-variant-numeric: tabular-nums;
    font-weight: var(--weight-medium);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .doc-title {
    font-family: var(--font-serif);
    font-weight: var(--weight-semibold);
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    max-width: var(--measure);
  }
  .doc-meta {
    grid-column: 2;
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  @media (max-width: 34rem) {
    .doc-card {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .doc-meta {
      grid-column: 1;
    }
  }
</style>
