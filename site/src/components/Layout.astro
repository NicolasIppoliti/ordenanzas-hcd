---
// Accessibility and Mobile Payload (design.md): html lang="es" (also
// selects Pagefind's Spanish stemmer in 4b), semantic landmarks, one <h1>
// per page (left to each page's own content), a skip link, focus-visible
// never removed, no colour-only signalling, system font stack, 0 KB JS
// except the staleness script pulled in via Provenance.
import Footer from './Footer.astro';
import StalenessNotice from './StalenessNotice.astro';
import { loadSyncStatus } from '../lib/data';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const syncStatus = loadSyncStatus();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <style is:global>
      @import '../styles/tokens.css';

      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: var(--font-sans);
        font-size: var(--text-base);
        line-height: var(--leading-normal);
        color: var(--text);
        background: var(--bg);
        /* Legal Spanish is full of long words; hyphenation keeps the ragged
           edge from tearing open on a narrow phone. */
        -webkit-text-size-adjust: 100%;
      }
      a {
        color: var(--link);
        text-underline-offset: 0.15em;
        transition: color var(--duration-micro) var(--ease-out);
      }
      a:hover {
        color: var(--link-hover);
      }
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--bg);
        color: var(--text);
        padding: var(--space-2) var(--space-4);
        z-index: 10;
        border: 2px solid var(--focus);
        border-radius: var(--radius-sm);
      }
      .skip-link:focus {
        left: var(--space-2);
        top: var(--space-2);
      }
      :focus-visible {
        outline: 3px solid var(--focus);
        outline-offset: 2px;
        border-radius: var(--radius-sm);
      }
      h1,
      h2,
      h3 {
        line-height: var(--leading-tight);
        /* Headings here are document titles, and a document title can run to a
           full sentence. Balancing the wrap keeps a lone orphan word off the
           last line without any measurement. */
        text-wrap: balance;
      }
      h1 {
        font-size: var(--text-2xl);
        margin: 0 0 var(--space-3);
      }
      h2 {
        font-size: var(--text-xl);
      }
      header,
      main,
      footer {
        max-width: var(--page-max);
        margin: 0 auto;
        padding: var(--space-4);
      }
      header {
        border-bottom: 1px solid var(--border);
        padding-block: var(--space-2);
      }
      nav {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2) var(--space-6);
        align-items: baseline;
        justify-content: space-between;
        width: 100%;
        font-size: var(--text-sm);
      }
      .site-name {
        font-weight: var(--weight-bold);
      }
      /* Touch targets: 48px is the web-mobile minimum, and these are the only
         navigation links on the site. The padding does the work; the text
         itself stays inline so the header does not turn into a button bar. */
      nav a,
      footer a {
        display: inline-block;
        padding-block: var(--space-2);
        min-height: 2.75rem;
        line-height: 1.6;
      }
      footer {
        border-top: 1px solid var(--border);
        color: var(--text-muted);
        font-size: var(--text-sm);
        margin-top: var(--space-12);
      }
      .provenance {
        font-size: var(--text-sm);
        color: var(--text-muted);
      }
      .disclaimer {
        font-size: var(--text-sm);
      }
      /* The staleness notice carries a second, non-colour signal: it is the only
         element on the site with a left rule. ~8% of readers will not see the
         amber at all. */
      #staleness-notice[hidden] {
        display: none;
      }
      #staleness-notice {
        margin-top: var(--space-4);
        color: var(--notice-text);
        background: var(--notice-bg);
        border: 1px solid var(--notice-border);
        border-left-width: 4px;
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-sm);
        font-size: var(--text-sm);
      }
      .muted {
        color: var(--text-muted);
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
    <header>
      <nav aria-label="Principal" data-pagefind-ignore>
        <a href="/" class="site-name">Ordenanzas del HCD</a>
        <a href="/acerca">Acerca</a>
      </nav>
    </header>
    <main id="main-content">
      <StalenessNotice
        lastSuccessAt={syncStatus.last_success_at}
        thresholdDays={syncStatus.staleness_threshold_days}
      />
      <slot />
    </main>
    <Footer syncStatus={syncStatus} />
  </body>
</html>
