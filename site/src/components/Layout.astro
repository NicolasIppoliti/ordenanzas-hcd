---
// Accessibility and Mobile Payload (design.md): html lang="es" (also
// selects Pagefind's Spanish stemmer in 4b), semantic landmarks, one <h1>
// per page (left to each page's own content), a skip link, focus-visible
// never removed, no colour-only signalling, two self-hosted Latin-subset
// webfonts totalling 47,008 bytes (DESIGN.md Typography), and 0 KB JS except
// the staleness script, which lives in StalenessNotice.
import Footer from './Footer.astro';
import SearchBand from './SearchBand.astro';
import StalenessNotice from './StalenessNotice.astro';
import { loadSyncStatus } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  /** Developer surfaces opt out of search engines. Archive pages never do. */
  noindex?: boolean;
  /** Set false by the two pages that render their own search field: the search
   *  page, with its filters, and the home, where the field is the hero. A second
   *  field in the header would duplicate the `q` id its label points at. Each
   *  page declares this rather than the header guessing from a path. */
  searchBand?: boolean;
}

const { title, description, noindex = false, searchBand = true } = Astro.props;
const syncStatus = loadSyncStatus();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* A @font-face is not discoverable until the stylesheet has been fetched
        and parsed, so without these the swap lands a full round trip late.
        Both are used on every page, so neither preload is speculative. */}
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <style is:global>
      @import '../styles/tokens.css';

      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: var(--font-sans);
        font-size: var(--text-base);
        line-height: var(--leading-normal);
        color: var(--text);
        background: var(--bg);
        /* Stops iOS Safari from inflating text when a phone is turned to
           landscape, which would break the 68ch measure the document pages are
           set to. Hyphenation is a separate concern and lives with the document
           text, in DocumentText.astro. */
        -webkit-text-size-adjust: 100%;
      }
      a {
        color: var(--link);
        text-underline-offset: 0.15em;
        transition: color var(--duration-micro) var(--ease-out);
      }
      a:hover {
        color: var(--link-hover);
      }
      /* Hidden by clipping, not by being parked off-canvas.
         `position: absolute; left: -9999px` is the classic form and it makes the
         page horizontally scrollable on iOS Safari, which counts overflow to the
         LEFT of the origin as scrollable area where Chromium clamps it. A phone
         could drag the whole layout sideways and read the header cut off at its
         left edge. Clipped at the origin, there is nothing to scroll to. */
      .skip-link {
        position: absolute;
        left: var(--space-2);
        top: var(--space-2);
        z-index: 10;
        /* Clipped to nothing, and with no padding or border of its own: those
           paint even when the content box is 1px, and the link would sit as a
           small bordered artefact in the corner of all 1,043 pages. */
        width: 1px;
        height: 1px;
        padding: 0;
        border: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        background: var(--bg);
        color: var(--text);
        border-radius: var(--radius-sm);
      }
      .skip-link:focus {
        width: auto;
        height: auto;
        padding: var(--space-2) var(--space-4);
        border: 2px solid var(--focus);
        overflow: visible;
        clip-path: none;
      }
      :focus-visible {
        outline: 3px solid var(--focus);
        outline-offset: 2px;
        border-radius: var(--radius-sm);
      }
      h1,
      h2,
      h3 {
        /* Serif for every heading: it is the Argentine convention for legal
           text, and it is most of what makes this read as a document archive
           rather than a dashboard. The weight is pinned to the one the file
           carries — asking for 700 does not fail, it makes the browser
           synthesise a fake bold by smearing the outlines, on exactly the
           lines a reader sees first. */
        font-family: var(--font-serif);
        font-weight: var(--weight-semibold);
        line-height: var(--leading-tight);
        /* Headings here are document titles, and a document title can run to a
           full sentence. Balancing the wrap keeps a lone orphan word off the
           last line without any measurement. */
        text-wrap: balance;
      }
      h1 {
        font-size: var(--text-2xl);
        margin: 0 0 var(--space-3);
      }
      h2 {
        font-size: var(--text-xl);
      }
      header,
      main,
      footer {
        max-width: var(--page-max);
        margin: 0 auto;
        padding: var(--space-4);
      }
      header {
        position: relative;
        border-bottom: 1px solid var(--border);
        padding-block: var(--space-3);
      }
      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0 var(--space-6);
        align-items: center;
        justify-content: space-between;
        width: 100%;
        font-size: var(--text-sm);
      }
      nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      /* The wide layout: a row of links, hidden until the breakpoint takes
         over. The media query that swaps the two lives at the END of this block,
         after every rule it has to beat — an earlier one loses to any later
         declaration of the same specificity, which is how the phone menu first
         shipped visible on a 1280px screen. */
      .nav-links {
        display: none;
      }

      /* The phone menu. The marker is removed and replaced by two rules that
         rotate into a cross when it opens — the state has to be visible without
         reading the label, and colour alone would not carry it. */
      /* The trigger stays on the brand's line and the panel drops out of flow
         beneath the whole header. A `<details>` left in flow grows when it
         opens, which pushed the brand onto a row of its own and squeezed the
         links into a column beside it. */
      .nav-menu {
        display: block;
      }
      .nav-menu summary {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        min-height: 3rem;
        padding-inline: var(--space-2);
        margin-inline: calc(var(--space-2) * -1);
        border-radius: var(--radius-sm);
        color: var(--link);
        cursor: pointer;
        list-style: none;
      }
      .nav-menu summary::-webkit-details-marker {
        display: none;
      }
      .bars {
        position: relative;
        display: block;
        width: 1.125rem;
        height: 2px;
        background: currentColor;
        transition: background var(--duration-micro) var(--ease-out);
      }
      .bars::before,
      .bars::after {
        content: '';
        position: absolute;
        left: 0;
        width: 100%;
        height: 2px;
        background: currentColor;
        transition: transform var(--duration-micro) var(--ease-out);
      }
      .bars::before {
        top: -6px;
      }
      .bars::after {
        top: 6px;
      }
      .nav-menu[open] .bars {
        background: transparent;
      }
      .nav-menu[open] .bars::before {
        transform: translateY(6px) rotate(45deg);
      }
      .nav-menu[open] .bars::after {
        transform: translateY(-6px) rotate(-45deg);
      }
      .nav-menu ul {
        position: absolute;
        left: 0;
        right: 0;
        top: 100%;
        z-index: 20;
        display: flex;
        flex-direction: column;
        padding-inline: var(--space-4);
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border);
      }
      .nav-menu li + li {
        border-top: 1px solid var(--border);
      }
      .nav-menu ul a {
        display: flex;
        align-items: center;
        min-height: 3rem;
      }

      /* The swap, LAST: an earlier media query loses to any later declaration of
         the same specificity, and the phone menu first shipped visible on a
         1280px screen because this sat above the rules it has to beat. */
      @media (min-width: 34rem) {
        .nav-links {
          display: flex;
          flex-wrap: wrap;
          gap: 0 var(--space-6);
        }
        .nav-menu {
          display: none;
        }
      }
      /* The name of the archive, in the archive's own face. It is not a
         destination competing with the two links beside it, so it carries
         neither their underline nor their colour. */
      .site-name {
        font-family: var(--font-serif);
        font-weight: var(--weight-semibold);
        font-size: var(--text-lg);
        color: var(--text);
        text-decoration: none;
      }
      .site-name:hover {
        color: var(--link);
      }
      /* Touch targets: 48px, the web-mobile minimum, matching the search band
         and the search page's controls. The padding does the work; the text
         itself stays inline so the header does not turn into a button bar. */
      nav a,
      footer a {
        display: inline-block;
        padding-block: var(--space-2);
        min-height: 3rem;
        line-height: 1.6;
      }
      footer {
        border-top: 1px solid var(--border);
        color: var(--text-muted);
        font-size: var(--text-sm);
        margin-top: var(--space-12);
      }
      .provenance {
        font-size: var(--text-sm);
        color: var(--text-muted);
      }
      .disclaimer {
        font-size: var(--text-sm);
      }
      /* The staleness notice carries a second, non-colour signal: it is the only
         element on the site with a left rule. ~8% of readers will not see the
         amber at all. */
      #staleness-notice[hidden] {
        display: none;
      }
      #staleness-notice {
        margin-top: var(--space-4);
        color: var(--notice-text);
        background: var(--notice-bg);
        border: 1px solid var(--notice-border);
        border-left-width: 4px;
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-sm);
        font-size: var(--text-sm);
      }
      .muted {
        color: var(--text-muted);
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido principal</a>
    <header>
      <nav aria-label="Principal" data-pagefind-ignore>
        {/* Two groups, not three peers: the name of the archive, and the places
            you can go.

            The links appear twice and CSS decides which set exists — a row on a
            wide screen, a `<details>` menu on a phone. `display: none` takes the
            other one out of the accessibility tree entirely, so nothing is
            announced twice, and both live inside this one landmark.

            A `<details>` rather than a button and a script: it is the platform's
            disclosure widget, it opens on tap and on Enter, and it costs zero
            bytes of JavaScript on all 1,043 pages. Measured first: CSS cannot
            force a closed `<details>` open on wide screens — its content stays
            0×0 — which is why the wide layout is its own list rather than the
            same one restyled. */}
        <a href="/" class="site-name">Ordenanzas del HCD</a>

        <ul class="nav-links">
          <li><a href="/documentos">Todos los documentos</a></li>
          <li><a href="/acerca">Acerca</a></li>
        </ul>

        <details class="nav-menu">
          {/* No `aria-label`: it would replace the visible "Menú" as the
              accessible name and keep saying "Abrir" while open. A `<summary>`
              already announces itself as expanded or collapsed. */}
          <summary>
            <span class="bars" aria-hidden="true"></span>
            Menú
          </summary>
          <ul>
            <li><a href="/documentos">Todos los documentos</a></li>
            <li><a href="/acerca">Acerca</a></li>
          </ul>
        </details>
      </nav>
      <SearchBand hidden={!searchBand} />
    </header>
    <main id="main-content">
      <StalenessNotice
        lastSuccessAt={syncStatus.last_success_at}
        thresholdDays={syncStatus.staleness_threshold_days}
      />
      <slot />
    </main>
    <Footer syncStatus={syncStatus} />
  </body>
</html>
